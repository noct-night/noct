# ---- Database (Supabase Postgres) -------------------------------------------
# Server-side code talks to Postgres directly with `pg`.
# On Vercel use the Supavisor *transaction* pooler (IPv4, port 6543):
#   postgresql://postgres.<project-ref>:<password>@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Locally you can point this at a local Postgres (see scripts/db-local.sh).
DATABASE_URL=

# Supabase project (used by the static frontend later; safe to expose the publishable key)
SUPABASE_URL=
SUPABASE_PUBLISHABLE_KEY=

# ---- Scheduling / security ---------------------------------------------------
# Vercel Cron sends `Authorization: Bearer $CRON_SECRET`; pg_cron -> pg_net sends the same header.
CRON_SECRET=

# ---- Source adapters ---------------------------------------------------------
# Comma-separated list of adapters to run (default: ra,dice,elsewhere,goodroom,publicrecords,ticketmaster,edmtrain
# minus any whose required key is missing).
NOCT_SOURCES=

# Cities to ingest (keys from src/lib/cities.ts: nyc, la, sf, chi, mia, dc, det, tor, ldn, ber). Default nyc.
# RA covers every city; the venue-direct feeds are New York only. Each city adds one RA area walk per run.
NOCT_CITIES=nyc

# Resident Advisor: no key. Public GraphQL endpoint used by ra.co itself. Read docs/DATA_SOURCES.md before enabling.
# (NOCT_RA_AREA_ID overrides New York's RA area only; other cities' areas come from the registry.)
NOCT_RA_AREA_ID=8

# DICE: requires an API key issued by DICE (partner / widget key). Adapter is skipped when unset.
DICE_API_KEY=

# EDMTrain official API client key (https://edmtrain.com/developer-api). Adapter is skipped when unset.
# NOTE: EDMTrain's API terms forbid combining their data with other sources in a competing discovery service.
EDMTRAIN_CLIENT_KEY=
# Set to 1 only under a written arrangement with EDM Train LLC; their API terms forbid multi-source discovery services.
NOCT_EDMTRAIN_ACCEPT_TERMS=

# Ticketmaster Discovery API consumer key (https://developer.ticketmaster.com). Adapter is skipped when unset.
TICKETMASTER_API_KEY=

# User-Agent for outbound fetches. Cloudflare-fronted hosts (ra.co/graphql) reject non-browser UAs.
NOCT_USER_AGENT=

# Time budgets for one ingest invocation (ms). Vercel functions are capped at 300s; defaults 270000 / 240000.
NOCT_RUN_BUDGET_MS=
NOCT_SOURCE_TIMEOUT_MS=

# ---- Enrichment (genre / vibe) ----------------------------------------------
# Which LLM runs the reconciliation step. Leave everything empty for rules-only.
#   anthropic : ANTHROPIC_API_KEY (+ NOCT_ENRICH_MODEL, default claude-opus-5; claude-haiku-4-5 is the cheapest)
#   openai    : any OpenAI-compatible /chat/completions endpoint — the free-tier route. Examples:
#               Google AI Studio  NOCT_LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai  NOCT_LLM_MODEL=gemini-3.6-flash  (or gemini-3.5-flash-lite)
#               Groq              NOCT_LLM_BASE_URL=https://api.groq.com/openai/v1                           NOCT_LLM_MODEL=llama-3.3-70b-versatile
#               Mistral           NOCT_LLM_BASE_URL=https://api.mistral.ai/v1                                NOCT_LLM_MODEL=mistral-small-latest
#               OpenRouter        NOCT_LLM_BASE_URL=https://openrouter.ai/api/v1                             NOCT_LLM_MODEL=<id ending in :free>
# Auto-detected from whichever key is present (Anthropic first); set NOCT_LLM_PROVIDER to force one or 'none'.
NOCT_LLM_PROVIDER=
ANTHROPIC_API_KEY=
NOCT_ENRICH_MODEL=claude-opus-5
NOCT_LLM_BASE_URL=
NOCT_LLM_API_KEY=
NOCT_LLM_MODEL=
# Free tiers are metered per minute: spacing between calls (ms, default 4000 ≈ 15/min). Each hourly cron run classifies <= ?limit events.
NOCT_LLM_MIN_INTERVAL_MS=
# json_schema (default) or json_object for providers that reject response_format json_schema (auto-falls back once anyway)
NOCT_LLM_JSON_MODE=
# Reasoning models: `reasoning_effort` (low recommended for Gemini 3.x — classification does not need deep thinking) and
# the completion cap (default 6000; thinking tokens count against it)
NOCT_LLM_REASONING_EFFORT=
NOCT_LLM_MAX_TOKENS=
# Optional $ per MTok to price a paid OpenAI-compatible model in classification_run.cost_usd (free tiers stay 0)
NOCT_LLM_PRICE_INPUT=
NOCT_LLM_PRICE_OUTPUT=
